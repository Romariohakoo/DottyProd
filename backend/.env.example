SERVER_PORT=8080

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=prod

SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# lax — фронт и backend на одном сайте
# none — фронт на localhost ходит в задеплоенный backend; включает COOKIE_SECURE сам
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,https://hack-kzn-11-vm1-5798eb.vm.prodcontest.com
# true на проде с ssl
COOKIE_SECURE=false

# Telegram OIDC (BotFather > Login Widget > OAuth 2.0, signing algorithm RS256)
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_REDIRECT_URI=http://localhost:8080/api/auth/telegram/callback
FRONTEND_URL=http://localhost:3000
# Optional: integration stub, no scheduler or automatic messages yet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATIONS_ENABLED=false

S3_ENDPOINT_URL=https://firsts3.ru
S3_REGION=default
S3_BUCKET=dotty
S3_ACCESS_KEY=
S3_SECRET_KEY=
