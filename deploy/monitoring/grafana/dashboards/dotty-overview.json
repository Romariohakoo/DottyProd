    {
      "id": 1,
      "type": "table",
      "title": "Эндпоинты за выбранный период",
      "description": "Каждая строка — ручка API. Запросов — сколько всего за период (справа сверху). В минуту — текущая нагрузка. 4xx — ошибки клиента (неверные данные, нет доступа), 5xx — ошибки сервера (баги). p50/p95/p99 — время ответа: половина / 95% / 99% запросов быстрее этого значения. Красным подсвечено то, на что стоит посмотреть.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, handler) (increase(http_requests_total{job=\"backend\"}[$__range]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "60 * sum by (method, handler) (rate(http_requests_total{job=\"backend\"}[5m]))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "100 * (sum by (method, handler) (increase(http_requests_total{job=\"backend\",status=\"4xx\"}[$__range])) or sum by (method, handler) (increase(http_requests_total{job=\"backend\"}[$__range])) * 0) / clamp_min(sum by (method, handler) (increase(http_requests_total{job=\"backend\"}[$__range])), 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "100 * (sum by (method, handler) (increase(http_requests_total{job=\"backend\",status=\"5xx\"}[$__range])) or sum by (method, handler) (increase(http_requests_total{job=\"backend\"}[$__range])) * 0) / clamp_min(sum by (method, handler) (increase(http_requests_total{job=\"backend\"}[$__range])), 1)",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "1000 * histogram_quantile(0.5, sum by (le, method, handler) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[$__range])))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, method, handler) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[$__range])))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "1000 * histogram_quantile(0.99, sum by (le, method, handler) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[$__range])))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "method": 0,
              "handler": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8
